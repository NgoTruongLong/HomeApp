# Increase FreeRTOS timer service task stack
# Fixes: "A stack overflow in task Tmr Svc has been detected"
# caused by ESP_LOGI() + xTimerChangePeriod()/xTimerStart() in pms_timer_cb
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# ======================== LVGL (ILI9488 3.5 inch display) ========================
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_DEPTH=16
# Giam tu 80 -> 56 KB: pool LVGL la .bss (RAM noi bo). Can du RAM noi bo cho
# stack task WebSocket/TLS vi FreeRTOS LUON cap stack tu internal RAM.
CONFIG_LV_MEM_SIZE_KILOBYTES=56
# Fonts used by the HomeApp dashboard UI
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ======================== Debug: stack (TEMPORARY) ========================
# Watchpoint panics as soon as a task overwrites its stack end. Turn off when done.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# ======================== Hardware: ESP32-S3 N16R8 ========================
# 16 MB flash + 8 MB Octal PSRAM. Octal PSRAM chiem GPIO33..37 nen loa
# (MAX98357A) phai dung chan khac (xem app/audio/max98357a.h).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y

# ======================== WebSocket / TLS (Xiaozhi voice chat) ========================
CONFIG_WS_BUFFER_SIZE=1024
# mbedTLS cap phat tu PSRAM (RAM noi bo da rat chat vi LVGL + Opus + task).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ======================== Partition table (custom) ========================
# App can be large now (Opus + WebSocket + LVGL). See partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
